#!/usr/bin/env bash
# Template for run-local.sh — copy this file to run-local.sh and fill in
# your real local Postgres credentials. run-local.sh is gitignored;
# this .example file is the only copy that gets committed.
#
# Usage:  source ./run-local.sh        # set vars in your current shell
#         ./run-local.sh --run         # set vars AND start the app (subshell)

# Only needed if JAVA_HOME doesn't already point at a JDK 21+ install.
export JAVA_HOME="/path/to/your/jdk"

export FLYWAY_DB_URL="jdbc:postgresql://127.0.0.1:5432/scheduler"
export FLYWAY_DB_USERNAME="postgres"
export FLYWAY_DB_PASSWORD="<your postgres superuser password>"

export APP_DB_URL="jdbc:postgresql://127.0.0.1:5432/scheduler"
export APP_DB_PASSWORD="<pick a strong password for scheduler_app>"

# Required, no default — generate one with: openssl rand -base64 48
export APP_JWT_SECRET="<generate with: openssl rand -base64 48>"

echo "Local dev env vars set (JAVA_HOME, FLYWAY_DB_*, APP_DB_*, APP_JWT_SECRET)."

if [ "$1" = "--run" ]; then
    cd "$(dirname "$0")"
    ./mvnw spring-boot:run
fi
